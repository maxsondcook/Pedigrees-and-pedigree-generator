# Copy to .env (never commit .env). Railway sets these for you in the cloud.
# Railway -> Postgres -> Connect -> "Public network" URL, for running locally / loading data:
DATABASE_URL=postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway

# Frontend origin(s) allowed to call the API (comma separated)
CROSSR_FRONTEND_ORIGIN=http://localhost:3000

# Set to 1 to ignore DATABASE_URL and use the local data/*.csv files
# CROSSR_FORCE_CSV=1
